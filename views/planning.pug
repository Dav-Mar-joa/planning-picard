extends layout

block head
  style.
    .mobile-only { display: none; }
    @media (max-width: 768px) {
      .desktop-only { display: none !important; }
      .mobile-only { display: block !important; }
    }
    /* Tableau résumé mobile — responsive sans scroll */
    .summary-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }
    .summary-table th,
    .summary-table td {
      padding: 0.45rem 0.2rem;
      text-align: center;
      border-bottom: 1px solid var(--border);
      overflow: hidden;
    }
    .summary-table th:first-child,
    .summary-table td:first-child {
      text-align: left;
      padding-left: 0.75rem;
      width: 22%;
    }
    .summary-table th {
      font-size: 0.58rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text3);
      background: var(--surface2);
      border-bottom: 2px solid var(--border);
    }
    .summary-table th.col-today { color: var(--accent); border-bottom-color: var(--accent); }
    .summary-cell-work {
      display: block;
      width: 100%;
      padding: 0.28rem 0;
      background: linear-gradient(135deg, rgba(232,160,32,0.2), rgba(232,160,32,0.07));
      border: 1px solid rgba(232,160,32,0.35);
      border-radius: 3px;
      font-size: 0.6rem;
      font-weight: 700;
      color: var(--accent);
    }
    .summary-cell-off {
      display: block;
      width: 100%;
      padding: 0.28rem 0;
      background: var(--surface3);
      border: 1px solid var(--border);
      border-radius: 3px;
      font-size: 0.56rem;
      color: var(--text3);
    }
    .emp-first { font-weight: 700; font-size: 0.75rem; color: var(--text); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .emp-hrs   { font-size: 0.58rem; color: var(--text3); display: block; }

block headerRight
  if semaines && semaines.length > 0
    select#week-select.form-select(style="width:auto;font-size:0.82rem;padding:0.35rem 2rem 0.35rem 0.65rem;" onchange="window.location='/?s='+encodeURIComponent(this.value)")
      each s in semaines
        option(value=s selected=s===semaineChoisie)
          | S#{s.split('/')[0]} · #{s.split('/')[1]}
          if s === semaineCourante
            |  ★
  a.btn.btn-ghost.btn-sm(href="/admin/login") Admin

block content
  .main-content

    //- HERO
    .page-hero
      .page-hero-inner
        div
          .page-title Planning des Présences
          .page-subtitle
            if semaineChoisie
              | Semaine #{semaineChoisie.split('/')[0]} · #{planning && planning.du ? planning.du + ' → ' + planning.au : ''}
              if semaineChoisie === semaineCourante
                |  
                span.badge.badge-green(style="vertical-align:middle;font-size:0.65rem; margin-left:1rem;") ● Semaine actuelle
              else
                |  
                span.badge.badge-ghost(style="vertical-align:middle;font-size:0.65rem; margin-left:1rem;") Sem. actuelle : S#{semaineCourante.split('/')[0]}
            else
              | Aucune semaine disponible

    if !planning || !planning.employes || planning.employes.length === 0
      .no-data
        .no-data-icon 📋
        .no-data-title Aucun planning
        .no-data-text Le manager n'a pas encore publié de planning.

    else

      //- ══ RÉSUMÉ VISUEL — DESKTOP UNIQUEMENT ══
      .desktop-only
        .mobile-summary
          .planning-table-wrap(style="padding-bottom:0;")
            .section-title(style="margin-bottom:0.75rem;") Vue d'ensemble
            table.planning-table(style="min-width:0;")
              thead
                tr
                  th(style="min-width:120px;") Jour
                  each emp in planning.employes
                    th(style="text-align:center;min-width:90px;white-space:nowrap;") #{emp.nom.split(' ')[0]}
              tbody
                each jour in jours
                  tr
                    td(style="padding:0.5rem 1.25rem;font-weight:600;font-size:0.8rem;color:var(--text2);")
                      span(class=jour===jourAujourdHui?'text-accent':'') #{labels[jour]}
                    each emp in planning.employes
                      - const travailleD = emp.planning[jour] && emp.planning[jour].length > 0
                      td(style="text-align:center;padding:0.4rem 0.5rem;")
                        if travailleD
                          span(style="display:inline-block;background:linear-gradient(135deg,rgba(232,160,32,0.25),rgba(232,160,32,0.1));border:1px solid rgba(232,160,32,0.35);border-radius:4px;padding:0.25rem 0.5rem;font-size:0.68rem;font-weight:700;color:var(--accent);") ✓
                        else
                          span(style="display:inline-block;background:var(--surface3);border:1px solid var(--border);border-radius:4px;padding:0.25rem 0.5rem;font-size:0.65rem;color:var(--text3);") REPOS

      //- Séparateur desktop
      .desktop-only
        div(style="height:1px;background:var(--border);margin:0 1.5rem;")

      //- ══ TABLEAU RÉSUMÉ — MOBILE UNIQUEMENT ══
      .mobile-only
        div(style="padding:1rem 0.75rem 0;")
          table.summary-table
            thead
              tr
                th Équipier
                each jour in jours
                  th(class=jour===jourAujourdHui?'col-today':'') #{labels[jour].substring(0,3)}
            tbody
              each emp in planning.employes
                - const hKeyM = emp.id || emp.nom
                - const hInfoM = heuresParEmp[hKeyM]
                tr
                  td
                    span.emp-first #{emp.nom.split(' ')[1]}
                    //- span.emp-hrs #{hInfoM ? hInfoM.fmt : ''}/#{emp.heuresHebdo}h
                  each jour in jours
                    - const travailleM = emp.planning[jour] && emp.planning[jour].length > 0
                    td
                      if travailleM
                        span.summary-cell-work ✓
                      else
                        span.summary-cell-off —

      //- Séparateur
      div(style="height:1px;background:var(--border);margin:1rem 0.75rem 0;")
        
      //- ══ TABLEAU DÉTAIL — DESKTOP ══
      .desktop-only
        .planning-table-wrap
          table.planning-table
            thead
              tr
                th Équipier
                th Heures
                each jour in jours
                  th(class=jour===jourAujourdHui ? 'col-today' : '') #{labels[jour]}
            tbody
              each emp in planning.employes
                - const hKey = emp.id || emp.nom
                - const hInfo = heuresParEmp[hKey]
                tr
                  td.emp-name-cell
                    .emp-name #{emp.nom}
                    //- .emp-id #{emp.id}
                  td(style="min-width:110px;")
                    if hInfo
                      .hours-counter
                        if hInfo
                          .emp-day-hours #{hInfo.fmt} &nbsp;(#{emp.heuresHebdo}h)
                  each jour in jours
                    td.jour-cell(class=jour===jourAujourdHui ? 'col-today' : '')
                      .creneau-stack
                        if emp.planning[jour] && emp.planning[jour].length > 0
                          each creneau, ci in emp.planning[jour]
                            span(class=`creneau-pill ${ci===0?'creneau-matin':'creneau-apmidi'}`) #{creneau.debut}–#{creneau.fin}
                        else
                          span.creneau-pill.creneau-repo REPOS

      //- ══ DÉTAIL PAR JOUR — MOBILE ══
      .mobile-only
        .day-tabs
          each jour in jours
            button.day-tab(data-jour=jour onclick=`switchDay('${jour}')`)
              | #{labels[jour].substring(0,3)}

        each jour in jours
          .day-panel(id=`panel-${jour}`)
            each emp in planning.employes
              - const hKey2 = emp.id || emp.nom
              - const hInfo2 = heuresParEmp[hKey2]
              .emp-day-card(data-collab="true")
                .emp-day-info
                  .emp-day-name #{emp.nom}
                    if hInfo2
                      .emp-day-hours #{hInfo2.fmt} &nbsp; (#{emp.heuresHebdo}h)
                .emp-day-creneaux
                  if emp.planning[jour] && emp.planning[jour].length > 0
                    each creneau, ci in emp.planning[jour]
                      span(class=`creneau-pill ${ci===0?'creneau-matin':'creneau-apmidi'}`) #{creneau.debut}–#{creneau.fin}
                  else
                    span.creneau-pill.creneau-repo REPOS

block footerRight
  .footer-note(style="font-size:0.65rem;color:var(--text3);") D.M.

block scripts
  script.
    const AUJOURD_HUI = '#{jourAujourdHui}';
    const JOURS = ['lun','mar','mer','jeu','ven','sam','dim'];

    //- function checkMobile() {
    //-   const isMobile = window.innerWidth <= 768;
    //-   document.querySelectorAll('.desktop-only').forEach(el => el.style.display = isMobile ? 'none' : '');
    //-   document.querySelectorAll('.mobile-only').forEach(el => el.style.display = isMobile ? 'block' : 'none');
    //- }
    //- checkMobile();
    //- window.addEventListener('resize', checkMobile);

    function switchDay(jour) {
      document.querySelectorAll('.day-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.day-panel').forEach(p => p.classList.remove('active'));
      const tab = document.querySelector(`.day-tab[data-jour="${jour}"]`);
      if (tab) { tab.classList.add('active'); tab.scrollIntoView({ inline: 'center', behavior: 'smooth', block: 'nearest' }); }
      const panel = document.getElementById(`panel-${jour}`);
      if (panel) panel.classList.add('active');
    }
    switchDay(JOURS.includes(AUJOURD_HUI) ? AUJOURD_HUI : 'lun');

