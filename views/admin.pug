extends layout

block head
  style.
    .mobile-only { display: none; }

block headerRight
  if tab === 'planning' && semaines && semaines.length > 0
    select#week-select-admin.form-select(style="width:auto;font-size:0.82rem;padding:0.35rem 2rem 0.35rem 0.65rem;" onchange=`window.location='/admin?pwd=${pwd}&s='+encodeURIComponent(this.value)`)
      each s in semaines
        option(value=s selected=s===semaineChoisie)
          | S#{s.split('/')[0]} · #{s.split('/')[1]}
          if s === semaineCourante
            |  ★
  if tab === 'planning'
    button.btn.btn-primary(type="submit" form="planning-form") 💾 
  a.btn.btn-ghost.btn-sm(href="/") ← Planning

block content
  .main-content

    //- HERO
    .page-hero
      .page-hero-inner
        div
          .page-title Administration
          .page-subtitle
            if tab === 'planning'
              | Gestion du planning
              if semaineChoisie === semaineCourante
                |  · 
                span.badge.badge-green(style="font-size:0.65rem;vertical-align:middle; margin-left:1rem;") ● Semaine actuelle
            else
              | Gestion des collaborateurs

    //- TABS
    .admin-tabs
      a.admin-tab(href=`/admin?pwd=${pwd}` class=tab==='planning'?'active':'')
        span.tab-icon 📅
        | Planning
      a.admin-tab(href=`/admin/collaborateurs?pwd=${pwd}` class=tab==='collaborateurs'?'active':'')
        span.tab-icon 👥
        | Collaborateurs

    //- SUCCESS
    if success
      .p-container
        .alert.alert-success
          | ✓ 
          if success === 'planning'
            | Planning sauvegardé sur GitHub !
          else if success === 'collab'
            | Collaborateur enregistré !
          else if success === 'delete'
            | Collaborateur supprimé.
          if success === 'deleted'
            | Semaine supprimée.

    //- ══════════════════════════════════
    //- TAB PLANNING
    //- ══════════════════════════════════
    if tab === 'planning'
      .p-container

        //- Nouvelle semaine
        .section-header
          .section-title Semaine à éditer
          button.btn.btn-sm(type="button" onclick="ouvrirModalSemaine()") + Nouvelle semaine

        //- Semaines existantes avec bouton supprimer
        if semaines && semaines.length > 0
          .flex.gap-1(style="flex-wrap:wrap;margin-bottom:1.25rem;")
            each s in semaines
              .flex.items-center(style="gap:0;")
                a.week-chip(href=`/admin?pwd=${pwd}&s=${encodeURIComponent(s)}` class=s===semaineChoisie?'active':'')
                  if s === semaineCourante
                    span.current-dot
                  | S#{s.split('/')[0]} · #{s.split('/')[1]}
                button.btn.btn-ghost.btn-sm(
                  type="button"
                  style="padding:0.3rem 0.4rem;border-radius:0 4px 4px 0;border-left:none;color:var(--danger);"
                  onclick=`deleteSemaine('${s}')`
                ) ✕

        form#planning-form(method="POST" action=`/admin/save?pwd=${pwd}`)
          input(type="hidden" name="pwd" value=pwd)

          //- Infos semaine
          .card(style="margin-bottom:1.25rem;")
            .card-header
              span(style="font-family:var(--font-display);font-weight:700;font-size:0.9rem;") Informations
            .card-body
              .flex.gap-2(style="flex-wrap:wrap;")
                .form-group(style="flex:1;min-width:150px;margin-bottom:0;")
                  label.form-label Numéro (ex: 14/2026)
                  input.form-input(type="text" name="semaine" value=planning?planning.semaine:'' placeholder="14/2026" required)
                .form-group(style="flex:1;min-width:130px;margin-bottom:0;")
                  label.form-label Début
                  input.form-input(type="text" name="du" value=planning?planning.du:'' placeholder="30/03/26")
                .form-group(style="flex:1;min-width:130px;margin-bottom:0;")
                  label.form-label Fin
                  input.form-input(type="text" name="au" value=planning?planning.au:'' placeholder="05/04/26")

          //- Équipiers
          .section-header
            .section-title Équipiers
          .flex.flex-col.gap-2#employes-list

            if planning && planning.employes && planning.employes.length > 0
              each emp, i in planning.employes
                - const hi = heuresInfo[emp.id || emp.nom]
                .employe-card(data-index=i)
                  .employe-card-header
                    .employe-card-header-left
                      .form-group(style="margin-bottom:0;min-width:200px;flex:2;")
                        label.form-label Nom complet
                        select.form-select(name=`employes[${i}][nom]`)
                          option(value=emp.nom) #{emp.nom}
                          each c in collaborateurs
                            option(value=`${c.nom} ${c.prenom}` selected=`${c.nom} ${c.prenom}`===emp.nom) #{c.nom} #{c.prenom}
                      .form-group(style="margin-bottom:0;min-width:130px;flex:1;")
                        label.form-label Matricule
                        input.form-input(type="text" name=`employes[${i}][id]` value=emp.id placeholder="Matricule" readonly style="opacity:0.6;cursor:not-allowed;")
                    //- button.btn.btn-danger.btn-sm(type="button" onclick="supprimerEmploye(this)") ✕
                  .employe-card-body
                    .jours-grid
                      each jour in jours
                        .jour-col
                          .jour-label-admin #{labels[jour].substring(0,3)}
                          .creneau-slot
                            .creneau-slot-label Matin
                            input(type="time" name=`employes[${i}][${jour}][0][debut]` value=emp.planning[jour]&&emp.planning[jour][0]?emp.planning[jour][0].debut:'' oninput="recalcHeures()")
                            input(type="time" name=`employes[${i}][${jour}][0][fin]` value=emp.planning[jour]&&emp.planning[jour][0]?emp.planning[jour][0].fin:'' oninput="recalcHeures()")
                          .creneau-slot
                            .creneau-slot-label Après-midi
                            input(type="time" name=`employes[${i}][${jour}][1][debut]` value=emp.planning[jour]&&emp.planning[jour][1]?emp.planning[jour][1].debut:'' oninput="recalcHeures()")
                            input(type="time" name=`employes[${i}][${jour}][1][fin]` value=emp.planning[jour]&&emp.planning[jour][1]?emp.planning[jour][1].fin:'' oninput="recalcHeures()")
                    .hours-admin-display
                      .hours-admin-label Heures placées :
                      .hours-admin-value(class=hi&&hi.over?'text-danger':hi&&hi.perfect?'text-success':'text-accent' data-hours-val)
                        | #{hi ? hi.fmt : '0h'}
                      if hi && hi.quota
                        .hours-admin-quota / #{hi.quotaFmt} quota
                        if hi.over
                          span.badge.badge-red(style="margin-left:0.4rem;") Dépassé
                        else if hi.perfect
                          span.badge.badge-green(style="margin-left:0.4rem;") ✓
            else
              //- Carte vide
              .employe-card(data-index="0")
                .employe-card-header
                  .employe-card-header-left
                    .form-group(style="margin-bottom:0;min-width:200px;flex:2;")
                      label.form-label Nom complet
                      select.form-select(name="employes[0][nom]" onchange="remplirMatricule(this,0)")
                        option(value="") — Choisir un équipier —
                        each c in collaborateurs
                          option(value=`${c.nom} ${c.prenom}` data-id=c.matricule data-quota=c.heuresHebdo) #{c.nom} #{c.prenom}
                    .form-group(style="margin-bottom:0;min-width:130px;flex:1;")
                      label.form-label Matricule
                      input.form-input(type="text" name="employes[0][id]" placeholder="Auto" readonly style="opacity:0.6;")
                  button.btn.btn-danger.btn-sm(type="button" onclick="supprimerEmploye(this)") ✕
                .employe-card-body
                  .jours-grid
                    each jour in jours
                      .jour-col
                        .jour-label-admin #{labels[jour].substring(0,3)}
                        .creneau-slot
                          .creneau-slot-label Matin
                          input(type="time" name=`employes[0][${jour}][0][debut]` oninput="recalcHeures()")
                          input(type="time" name=`employes[0][${jour}][0][fin]` oninput="recalcHeures()")
                        .creneau-slot
                          .creneau-slot-label Après-midi
                          input(type="time" name=`employes[0][${jour}][1][debut]` oninput="recalcHeures()")
                          input(type="time" name=`employes[0][${jour}][1][fin]` oninput="recalcHeures()")
                  .hours-admin-display
                    .hours-admin-label Heures placées :
                    .hours-admin-value.text-accent(data-hours-val) 0h
                    .hours-admin-quota(data-quota-label) —

          button.add-btn-dashed(type="button" onclick="ajouterEmploye()") + Ajouter un équipier

    //- ══════════════════════════════════
    //- TAB COLLABORATEURS
    //- ══════════════════════════════════
    else if tab === 'collaborateurs'
      .p-container
        .section-header
          .section-title #{collaborateurs.length} collaborateur(s)
          button.btn.btn-primary(type="button" onclick="ouvrirModalCollab()") + Ajouter

        if collaborateurs.length === 0
          .no-data
            .no-data-icon 👥
            .no-data-title Aucun collaborateur
            .no-data-text Ajoutez vos équipiers pour pouvoir les sélectionner dans le planning.
        else
          .collab-grid
            each collab, idx in collaborateurs
              .collab-card
                .collab-card-top
                  .collab-avatar #{collab.prenom.charAt(0)}#{collab.nom.charAt(0)}
                  .collab-info
                    .collab-name #{collab.prenom} #{collab.nom}
                    .collab-id #{collab.matricule}
                  .collab-actions
                    button.btn.btn-ghost.btn-sm(type="button" onclick=`editerCollab(${idx})`) ✏
                    form(method="POST" action=`/admin/collaborateurs/delete?pwd=${pwd}` style="display:inline;" onsubmit="return confirm('Supprimer ?')")
                      input(type="hidden" name="pwd" value=pwd)
                      input(type="hidden" name="index" value=idx)
                      //- button.btn.btn-danger.btn-sm(type="submit") ✕
                .collab-meta
                  span.badge(class=collab.contrat==='CDI'?'badge-green':'badge-blue') #{collab.contrat}
                  span.badge.badge-accent #{collab.heuresHebdo}h/sem
                  if collab.dateNaissance
                    span.badge.badge-ghost #{collab.dateNaissance}

    //- MODAL NOUVELLE SEMAINE
    .modal-overlay#modal-semaine
      .modal
        .modal-header
          .modal-title Nouvelle semaine
          button.modal-close(onclick="fermerModalSemaine()") ✕
        .modal-body
          .form-group
            label.form-label Choisir la semaine
            select.form-select#ms-semaine(onchange="onSemaineChange(this.value)")
              each s in semainesDispo
                - const dates = datesDeSemaine(s)
                option(value=s selected=s===semaineCourante)
                  | S#{s.split('/')[0]} · #{s.split('/')[1]}
                  if s === semaineCourante
                    |  ★ actuelle
          .card(style="margin-top:1rem;background:var(--bg2);border:1px solid var(--border);")
            .card-body(style="padding:0.85rem 1rem;")
              .flex.items-center.justify-between
                div
                  .form-label(style="margin-bottom:2px;") Du
                  div#ms-du-display(style="font-weight:700;font-size:0.95rem;color:var(--text);") —
                div(style="color:var(--text3);font-size:1.2rem;") →
                div
                  .form-label(style="margin-bottom:2px;text-align:right;") Au
                  div#ms-au-display(style="font-weight:700;font-size:0.95rem;color:var(--text);text-align:right;") —
        .modal-footer
          button.btn(type="button" onclick="fermerModalSemaine()") Annuler
          button.btn.btn-primary(type="button" onclick="creerSemaine()") Créer cette semaine

    //- MODAL COLLABORATEUR
    .modal-overlay#modal-collab
      .modal
        .modal-header
          .modal-title#modal-collab-title Ajouter un collaborateur
          button.modal-close(onclick="fermerModalCollab()") ✕
        .modal-body
          form#collab-form(method="POST" action=`/admin/collaborateurs/save?pwd=${pwd}`)
            input(type="hidden" name="pwd" value=pwd)
            input#collab-edit-index(type="hidden" name="editIndex" value="")
            .flex.gap-2(style="flex-wrap:wrap;")
              .form-group(style="flex:1;min-width:140px;")
                label.form-label Nom
                input.form-input(type="text" name="nom" placeholder="DUPONT" required)
              .form-group(style="flex:1;min-width:140px;")
                label.form-label Prénom
                input.form-input(type="text" name="prenom" placeholder="Marie" required)
            .form-group
              label.form-label Matricule
              input.form-input(type="text" name="matricule" placeholder="00012345" required)
            .flex.gap-2(style="flex-wrap:wrap;")
              .form-group(style="flex:1;min-width:140px;")
                label.form-label Date de naissance
                input.form-input(type="text" name="dateNaissance" placeholder="15/06/1990")
              .form-group(style="flex:1;min-width:120px;")
                label.form-label Heures / semaine
                input.form-input(type="number" name="heuresHebdo" placeholder="35" min="1" max="48" step="0.5" required)
              .form-group(style="flex:1;min-width:100px;")
                label.form-label Contrat
                select.form-select(name="contrat")
                  option(value="CDI") CDI
                  option(value="CDD") CDD
            .modal-footer(style="padding:0;border:none;margin-top:0.5rem;")
              button.btn(type="button" onclick="fermerModalCollab()") Annuler
              button.btn.btn-primary(type="submit") Enregistrer

block footerRight
  span

block scripts
  script.
    const PWD = '#{pwd}';
    const JOURS = ['lun','mar','mer','jeu','ven','sam','dim'];
    const LABELS = { lun:'Lundi', mar:'Mardi', mer:'Mercredi', jeu:'Jeudi', ven:'Vendredi', sam:'Samedi', dim:'Dimanche' };
    const COLLABS = !{JSON.stringify(collaborateurs || [])};

    // ── SUPPRIMER SEMAINE
    async function deleteSemaine(semaine) {
      if (!confirm(`Supprimer la semaine ${semaine} ?`)) return;
      try {
        const res = await fetch('/admin/delete-semaine', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pwd: PWD, semaine })
        });
        const data = await res.json();
        if (data.ok) {
          window.location.href = `/admin?pwd=${PWD}&success=deleted`;
        } else {
          alert('Erreur : ' + (data.error || 'inconnue'));
        }
      } catch(e) {
        alert('Erreur réseau : ' + e.message);
      }
    }

    // ── MODAL SEMAINE
    const SEMAINE_COURANTE = '#{semaineCourante}';

    function getDatesDeSemaine(semaine) {
      // Calcul côté client identique à utils.js
      const [week, year] = semaine.split('/').map(Number);
      const jan4 = new Date(Date.UTC(year, 0, 4));
      const dayOfWeek = jan4.getUTCDay() || 7;
      const lundi = new Date(jan4);
      lundi.setUTCDate(jan4.getUTCDate() - (dayOfWeek - 1) + (week - 1) * 7);
      const dimanche = new Date(lundi);
      dimanche.setUTCDate(lundi.getUTCDate() + 6);
      const fmt = d => `${String(d.getUTCDate()).padStart(2,'0')}/${String(d.getUTCMonth()+1).padStart(2,'0')}/${String(d.getUTCFullYear()).slice(2)}`;
      return { du: fmt(lundi), au: fmt(dimanche) };
    }

    function onSemaineChange(val) {
      const dates = getDatesDeSemaine(val);
      document.getElementById('ms-du-display').textContent = dates.du;
      document.getElementById('ms-au-display').textContent = dates.au;
    }

    function ouvrirModalSemaine() {
      const sel = document.getElementById('ms-semaine');
      onSemaineChange(sel.value); // init dates
      document.getElementById('modal-semaine').classList.add('open');
    }
    function fermerModalSemaine() { document.getElementById('modal-semaine').classList.remove('open'); }
    function creerSemaine() {
      const s = document.getElementById('ms-semaine').value;
      const dates = getDatesDeSemaine(s);
      window.location.href = `/admin?pwd=${PWD}&s=${encodeURIComponent(s)}&new=1&du=${encodeURIComponent(dates.du)}&au=${encodeURIComponent(dates.au)}`;
    }
    document.getElementById('modal-semaine').addEventListener('click', e => { if (e.target===e.currentTarget) fermerModalSemaine(); });

    // Pré-remplir si ?new=1
    const params = new URLSearchParams(window.location.search);
    if (params.get('new') === '1') {
      const si = document.querySelector('input[name="semaine"]');
      const di = document.querySelector('input[name="du"]');
      const ai = document.querySelector('input[name="au"]');
      if (si && !si.value) si.value = decodeURIComponent(params.get('s') || '');
      if (di && !di.value) di.value = decodeURIComponent(params.get('du') || '');
      if (ai && !ai.value) ai.value = decodeURIComponent(params.get('au') || '');
    }

    // ── MODAL COLLAB
    function ouvrirModalCollab() {
      document.getElementById('modal-collab-title').textContent = 'Ajouter un collaborateur';
      document.getElementById('collab-edit-index').value = '';
      document.getElementById('collab-form').reset();
      document.getElementById('modal-collab').classList.add('open');
    }
    function fermerModalCollab() { document.getElementById('modal-collab').classList.remove('open'); }
    function editerCollab(idx) {
      const c = COLLABS[idx];
      if (!c) return;
      document.getElementById('modal-collab-title').textContent = 'Modifier un collaborateur';
      document.getElementById('collab-edit-index').value = idx;
      const f = document.getElementById('collab-form');
      f.nom.value = c.nom;
      f.prenom.value = c.prenom;
      f.matricule.value = c.matricule;
      f.dateNaissance.value = c.dateNaissance || '';
      f.heuresHebdo.value = c.heuresHebdo;
      f.contrat.value = c.contrat;
      document.getElementById('modal-collab').classList.add('open');
    }
    document.getElementById('modal-collab').addEventListener('click', e => { if (e.target===e.currentTarget) fermerModalCollab(); });

    // ── REMPLIR MATRICULE depuis select collaborateur
    function remplirMatricule(select, idx) {
      const opt = select.options[select.selectedIndex];
      const id = opt.dataset.id || '';
      const quota = opt.dataset.quota || '';
      const card = select.closest('.employe-card');
      const idInput = card.querySelector('input[name*="[id]"]');
      if (idInput) idInput.value = id;
      const quotaLabel = card.querySelector('[data-quota-label]');
      if (quotaLabel) quotaLabel.textContent = quota ? `/ ${formatH(parseFloat(quota))} quota` : '—';
      recalcHeures();
    }

    // ── CALCUL HEURES EN TEMPS RÉEL
    function timeToMins(t) {
      if (!t) return 0;
      const [h, m] = t.split(':').map(Number);
      return h * 60 + m;
    }
    function formatH(h) {
      const hrs = Math.floor(h);
      const mins = Math.round((h - hrs) * 60);
      return mins === 0 ? `${hrs}h` : `${hrs}h${String(mins).padStart(2,'0')}`;
    }
    function recalcHeures() {
      document.querySelectorAll('.employe-card').forEach(card => {
        let total = 0;
        card.querySelectorAll('.creneau-slot').forEach(slot => {
          const inputs = slot.querySelectorAll('input[type="time"]');
          if (inputs.length === 2 && inputs[0].value && inputs[1].value) {
            const diff = timeToMins(inputs[1].value) - timeToMins(inputs[0].value);
            if (diff > 0) total += diff;
          }
        });
        const h = total / 60;
        const valEl = card.querySelector('[data-hours-val]');
        if (valEl) {
          valEl.textContent = formatH(h);
          valEl.className = 'hours-admin-value ' + (h === 0 ? 'text-muted' : 'text-accent');
        }
      });
    }
    recalcHeures();

    // ── AJOUTER ÉQUIPIER
    function getNextIndex() { return document.querySelectorAll('.employe-card').length; }
    function ajouterEmploye() {
      const i = getNextIndex();
      const list = document.getElementById('employes-list');

      let joursHtml = '';
      JOURS.forEach(jour => {
        const short = LABELS[jour].substring(0,3);
        joursHtml += `<div class="jour-col">
          <div class="jour-label-admin">${short}</div>
          <div class="creneau-slot">
            <div class="creneau-slot-label">Matin</div>
            <input type="time" name="employes[${i}][${jour}][0][debut]" oninput="recalcHeures()">
            <input type="time" name="employes[${i}][${jour}][0][fin]" oninput="recalcHeures()">
          </div>
          <div class="creneau-slot">
            <div class="creneau-slot-label">Après-midi</div>
            <input type="time" name="employes[${i}][${jour}][1][debut]" oninput="recalcHeures()">
            <input type="time" name="employes[${i}][${jour}][1][fin]" oninput="recalcHeures()">
          </div>
        </div>`;
      });

      const collabOptions = COLLABS.map(c =>
        `<option value="${c.nom} ${c.prenom}" data-id="${c.matricule}" data-quota="${c.heuresHebdo}">${c.nom} ${c.prenom}</option>`
      ).join('');

      const card = document.createElement('div');
      card.className = 'employe-card';
      card.dataset.index = i;
      card.innerHTML = `
        <div class="employe-card-header">
          <div class="employe-card-header-left">
            <div class="form-group" style="margin-bottom:0;min-width:200px;flex:2;">
              <label class="form-label">Nom complet</label>
              <select class="form-select" name="employes[${i}][nom]" onchange="remplirMatricule(this,${i})">
                <option value="">— Choisir un équipier —</option>
                ${collabOptions}
              </select>
            </div>
            <div class="form-group" style="margin-bottom:0;min-width:130px;flex:1;">
              <label class="form-label">Matricule</label>
              <input class="form-input" type="text" name="employes[${i}][id]" placeholder="Auto" readonly style="opacity:0.6;">
            </div>
          </div>
          <button type="button" class="btn btn-danger btn-sm" onclick="supprimerEmploye(this)">✕</button>
        </div>
        <div class="employe-card-body">
          <div class="jours-grid">${joursHtml}</div>
          <div class="hours-admin-display">
            <div class="hours-admin-label">Heures placées :</div>
            <div class="hours-admin-value text-accent" data-hours-val>0h</div>
            <div class="hours-admin-quota" data-quota-label>—</div>
          </div>
        </div>`;
      list.appendChild(card);
    }

    function supprimerEmploye(btn) {
      const card = btn.closest('.employe-card');
      if (document.querySelectorAll('.employe-card').length <= 1) return;
      card.style.opacity = '0'; card.style.transform = 'translateX(10px)'; card.style.transition = 'all 0.2s';
      setTimeout(() => {
        card.remove();
        document.querySelectorAll('.employe-card').forEach((c, idx) => {
          c.dataset.index = idx;
          c.querySelectorAll('[name]').forEach(el => {
            el.name = el.name.replace(/employes\[\d+\]/, `employes[${idx}]`);
          });
        });
        recalcHeures();
      }, 200);
    }
